{
    "info": {
        "_postman_id": "ms-bluedot-api-collection",
        "name": "MS BlueDot API",
        "description": "Micro-serviço de gerenciamento de imagens de produtos integrado com Cloudflare Images API.\n\n**Autenticação:** Execute o request `Auth > Login` e o token será armazenado automaticamente nas variáveis de ambiente.\n\n**Base URL:** {{baseUrl}}\n\n**Documentação:** {{baseUrl}}/swagger-ui.html",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "https://app-producao-apibluedot-yyjz.hospedagemelastica.com.br/api/v1",
            "type": "default"
        },
        {
            "key": "baseUrlLocal",
            "value": "http://localhost:8080/api/v1",
            "type": "default"
        },
        {
            "key": "accessToken",
            "value": "",
            "type": "default"
        },
        {
            "key": "refreshToken",
            "value": "",
            "type": "default"
        }
    ],
    "auth": {
        "type": "bearer",
        "bearer": [
            {
                "key": "token",
                "value": "{{accessToken}}",
                "type": "string"
            }
        ]
    },
    "item": [
        {
            "name": "Auth",
            "description": "Autenticação JWT - Login, Refresh e Logout",
            "item": [
                {
                    "name": "Login",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 200) {",
                                    "    const json = pm.response.json();",
                                    "    pm.collectionVariables.set('accessToken', json.accessToken);",
                                    "    pm.collectionVariables.set('refreshToken', json.refreshToken);",
                                    "    console.log('Tokens armazenados com sucesso!');",
                                    "    pm.test('Login realizado com sucesso', () => pm.response.to.have.status(200));",
                                    "    pm.test('Possui accessToken', () => pm.expect(json.accessToken).to.be.a('string'));",
                                    "}"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "auth": {
                            "type": "noauth"
                        },
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"nome\": \"admin\",\n  \"senha\": \"senha123\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/auth/login",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "auth",
                                "login"
                            ]
                        }
                    }
                },
                {
                    "name": "Refresh Token",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 200) {",
                                    "    const json = pm.response.json();",
                                    "    pm.collectionVariables.set('accessToken', json.accessToken);",
                                    "    pm.collectionVariables.set('refreshToken', json.refreshToken);",
                                    "    pm.test('Refresh realizado com sucesso', () => pm.response.to.have.status(200));",
                                    "}"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "auth": {
                            "type": "noauth"
                        },
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/auth/refresh",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "auth",
                                "refresh"
                            ]
                        }
                    }
                },
                {
                    "name": "Logout",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/auth/logout",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "auth",
                                "logout"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "Empresas",
