                            "raw": "{\n  \"codigoErp\": \"ERP-001-ATUALIZADO\",\n  \"nome\": \"Empresa Exemplo Atualizada\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/empresas/1",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "empresas",
                                "1"
                            ]
                        }
                    }
                },
                {
                    "name": "Remover Empresa",
                    "request": {
                        "method": "DELETE",
                        "url": {
                            "raw": "{{baseUrl}}/empresas/1",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "empresas",
                                "1"
                            ]
                        }
                    }
                }
            ]
        },
