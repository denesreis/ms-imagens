# Variáveis de Ambiente - ms-bluedot
# ATENÇÃO: Este arquivo é apenas um TEMPLATE.
# Copie como .env e preencha com os valores reais.
# NUNCA comite o arquivo .env!

# ===================================================
# Database (PostgreSQL)
# ===================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=msbluedot
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL=jdbc:postgresql://localhost:5432/msbluedot

# ===================================================
# JWT
# ===================================================
# OBRIGATÓRIO: mínimo 256 bits para HS256
JWT_SECRET=troque-esta-chave-por-um-valor-seguro-de-pelo-menos-256-bits
JWT_EXPIRATION=1800000
JWT_REFRESH_EXPIRATION=604800000

# ===================================================
# Cloudflare Images API
# ===================================================
CLOUDFLARE_ACCOUNT_ID=seu-account-id-aqui
CLOUDFLARE_GET_TOKEN=seu-get-token-aqui
CLOUDFLARE_POST_TOKEN=seu-post-token-aqui

# ===================================================
# Servidor
# ===================================================
SERVER_PORT=8080
SPRING_PROFILE=dev

# ===================================================
# Compressão de Imagem
# ===================================================
IMAGE_COMPRESSION_ENABLED=true
IMAGE_MAX_WIDTH=1920
IMAGE_MAX_HEIGHT=1080
IMAGE_QUALITY=0.85

# ===================================================
# Segurança - Brute Force
# ===================================================
LOGIN_MAX_ATTEMPTS=5
LOGIN_BLOCK_DURATION=900000

# ===================================================
# Produção
# ===================================================
SWAGGER_ENABLED=false

