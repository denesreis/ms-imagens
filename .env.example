# ==============================================================================
# ms-bluedot - Variáveis de ambiente (template)
# ==============================================================================
# Copie para `.env` e preencha valores reais. NUNCA versionar `.env`.
# Na VPS: chmod 600 .env
# Variáveis obrigatórias validadas por scripts/deploy.sh:
#   APP_DOMAIN, APP_PORT, APP_HEALTH_PATH, PUBLIC_HEALTH_URL,
#   POSTGRES_DB, POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_HOST_PORT
# ==============================================================================

# ----- Identidade / Traefik -----
APP_DOMAIN=mercador.bluedoterp.com.br
APP_PORT=8080
APP_HEALTH_PATH=/api/v1/health
PUBLIC_HEALTH_URL=https://mercador.bluedoterp.com.br/api/v1/health

# ----- PostgreSQL (container local na VPS) -----
POSTGRES_DB=msbluedot
POSTGRES_USER=msbluedot
POSTGRES_PASSWORD=change-this-strong-password
# Porta local do host (loopback) — registrada em bluedot-handbook/infra/vps/portas.md
POSTGRES_HOST_PORT=5436

# ----- JWT (OBRIGATÓRIO) -----
# Gerar com: openssl rand -base64 64
JWT_SECRET=change-this-to-a-strong-secret-with-at-least-256-bits
JWT_EXPIRATION=1800000
JWT_REFRESH_EXPIRATION=604800000

# ----- Cloudflare Images -----
CLOUDFLARE_ACCOUNT_ID=change-this
CLOUDFLARE_GET_TOKEN=change-this
CLOUDFLARE_POST_TOKEN=change-this

# ----- Configurações opcionais -----
IMAGE_COMPRESSION_ENABLED=true
LOGIN_MAX_ATTEMPTS=5
LOGIN_BLOCK_DURATION=900000
SWAGGER_ENABLED=false
